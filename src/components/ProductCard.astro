---
interface Props {
  title: string
  imageUrl: string
  imageAlt: string
  rating?: string
  reviewCount?: string
  priceRange: string
  features?: string[]
  affiliateUrl: string
  badge?: string
}

const {
  title,
  imageUrl,
  imageAlt,
  rating = '4.6 out of 5 stars',
  reviewCount = '',
  priceRange,
  features = [],
  affiliateUrl,
  badge,
} = Astro.props
---

<div class='product-card-wrapper'>
  <div class='product-card'>
    {badge && <div class='product-card-badge'>{badge}</div>}

    <div class='product-card-inner'>
      <!-- Product Image -->
      <div class='product-card-image'>
        <img src={imageUrl} alt={imageAlt} loading='lazy' />
      </div>

      <!-- Product Info -->
      <div class='product-card-info'>
        <h3 class='product-card-title'>{title}</h3>

        <!-- Rating -->
        <div class='product-card-rating'>
          <span class='stars'>⭐</span>
          <span class='rating-text'>{rating}</span>
          {reviewCount && <span class='review-count'>{reviewCount} reviews</span>}
        </div>

        <!-- Price -->
        <div class='product-card-price'>{priceRange}</div>

        <!-- Key Features -->
        {features.length > 0 && (
          <ul class='product-card-features'>
            {features.slice(0, 4).map(f => (
              <li>✓ {f}</li>
            ))}
          </ul>
        )}

        <!-- CTA Button -->
        <a
          href={affiliateUrl}
          target='_blank'
          rel='noopener noreferrer nofollow'
          class='product-card-button'
        >
          Check Price on Amazon →
        </a>
        <p class='product-card-disclaimer'>As an Amazon Associate, I earn from qualifying purchases.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .product-card-wrapper {
    margin: 2rem 0;
    clear: both;
  }

  .product-card {
    position: relative;
    border: 2px solid var(--border, #e7e7e7);
    border-radius: 12px;
    overflow: hidden;
    background: var(--card, #f9f9f9);
    transition: box-shadow 0.3s ease;
  }

  .product-card:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }

  .product-card-badge {
    position: absolute;
    top: 12px;
    left: -8px;
    background: linear-gradient(135deg, #FFA726, #FF6F00);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 14px 4px 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
    clip-path: polygon(0 0, 100% 0, 95% 50%, 100% 100%, 0 100%, 6px 50%);
  }

  .product-card-inner {
    display: flex;
    gap: 0;
    padding: 24px;
    align-items: stretch;
  }

  /* Image Section */
  .product-card-image {
    flex: 0 0 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 8px;
    padding: 16px;
    margin-right: 20px;
  }

  .product-card-image img {
    max-width: 100%;
    max-height: 180px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* Info Section */
  .product-card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    min-width: 0;
  }

  .product-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--foreground, #1a1a1a);
    margin: 0;
    line-height: 1.4;
  }

  .product-card-rating {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .stars {
    font-size: 16px;
    color: #FFA726;
    letter-spacing: 1px;
  }

  .rating-text {
    font-size: 14px;
    font-weight: 600;
    color: var(--foreground, #1a1a1a);
  }

  .review-count {
    font-size: 13px;
    color: var(--muted-foreground, #666);
  }

  .product-card-price {
    font-size: 1.25rem;
    font-weight: 800;
    color: #B12704;
    letter-spacing: -0.5px;
  }

  .product-card-features {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-card-features li {
    font-size: 13px;
    color: var(--foreground, #333);
    padding-left: 4px;
    line-height: 1.5;
  }

  .product-card-features li::before {
    content: '';
    margin-right: 6px;
  }

  .product-card-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
    padding: 12px 28px;
    background: #FFD814;
    border: 1px solid #F0C14B;
    border-radius: 24px;
    color: #0F1111;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    align-self: flex-start;
    letter-spacing: 0.2px;
  }

  .product-card-button:hover {
    background: #F7CA00;
    border-color: #E2B808;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 216, 20, 0.4);
  }

  .product-card-disclaimer {
    font-size: 11px;
    color: var(--muted-foreground, #999);
    margin: 4px 0 0;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .product-card-inner {
      flex-direction: column;
      padding: 16px;
    }

    .product-card-image {
      flex: none;
      margin-right: 0;
      margin-bottom: 16px;
      max-width: 160px;
      margin-left: auto;
      margin-right: auto;
    }

    .product-card-button {
      align-self: stretch;
      justify-content: center;
      text-align: center;
    }
  }

  /* Dark mode */
  .dark .product-card {
    background: var(--card, #1a1a2e);
    border-color: var(--border, #333);
  }

  .dark .product-card-image {
    background: #1e1e2e;
  }

  .dark .product-card-image img {
    filter: brightness(0.9);
  }

  .dark .product-card-title {
    color: var(--foreground, #e0e0e0);
  }

  .dark .product-card-features li {
    color: var(--foreground, #ccc);
  }

  .dark .product-card-disclaimer {
    color: var(--muted-foreground, #777);
  }

  .dark .product-card-button {
    background: #F7CA00;
    border-color: #E2B808;
  }

  .dark .product-card-button:hover {
    background: #FFD814;
    box-shadow: 0 4px 12px rgba(247, 202, 0, 0.3);
  }

  /* Override prose styles */
  .product-card-wrapper :global(.prose) &,
  .product-card-wrapper .product-card {
    all: revert;
  }
</style>
